{
  "name": "pdf-annotation-app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "db:local:migrate": "npm run db:local:sync-migrate",
    "db:remote:migrate": "npm run db:remote:sync-migrate",
    "predev": "npm run sync:generate && npm run pdfjs:assets && npm run typecheck",
    "prebuild": "npm run sync:check && npm run pdfjs:assets && npm run typecheck",
    "dev": "vinext dev --port 3000 --hostname 0.0.0.0",
    "build": "vinext build",
    "predeploy": "npm run sync:check && npm run pdfjs:assets && npm run typecheck",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "start": "vite preview",
    "typecheck": "tsc --noEmit --incremental false",
    "sync:generate": "sync-engine-vinext generate",
    "sync:check": "sync-engine-vinext generate --check",
    "cf:types": "wrangler types worker-configuration.d.ts --include-runtime false",
    "db:local:sync-migrate": "wrangler d1 execute pdf_annotation --local --file ./migrations/0001_sync_pdf_annotation.sql && wrangler d1 execute pdf_annotation --local --file ./migrations/0003_auth_sessions.sql",
    "db:remote:sync-migrate": "wrangler d1 execute pdf_annotation --remote --file ./migrations/0001_sync_pdf_annotation.sql && wrangler d1 execute pdf_annotation --remote --file ./migrations/0003_auth_sessions.sql",
    "pdfjs:assets": "node scripts/prepare-pdfjs.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:sync": "playwright test --config playwright.sync.config.ts",
    "pretest:browser": "npm run pdfjs:assets",
    "postinstall": "npm run pdfjs:assets"
  },
  "dependencies": {
    "@mintcd/sync-engine": "file:vendor/mintcd-sync-engine-2.2.0.tgz",
    "@mintcd/sync-engine-vinext": "file:vendor/mintcd-sync-engine-vinext-1.0.0.tgz",
    "katex": "^0.16.47",
    "lucide-react": "^1.17.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-rsc": "^0.5.28",
    "autoprefixer": "^10.0.1",
    "postcss": "^8.4.38",
    "react-server-dom-webpack": "^19.2.7",
    "tailwindcss": "^4.1.17",
    "tsx": "4.23.15",
    "typescript": "^5.8.2",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "vite-plugin-eruda": "^1.0.1",
    "wrangler": "^4.69.0"
  }
}
